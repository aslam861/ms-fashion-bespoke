# M.S Fashion - Server Environment Configuration Template
# Copy this file to .env and update with your credentials

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ms_fashion
WHATSAPP_PHONE=918999386222
NODE_ENV=development

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Customer Appointment OTP Verification (Gmail SMTP Service)
# Generate a 16-digit Google App Password from: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
